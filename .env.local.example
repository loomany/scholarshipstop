# Optional: Resend sends “confirm when ready” after onboarding (instant Supabase login + app-level email_verified).
RESEND_API_KEY=
# Optional override; default sender is ScholarshipTop <hello@mail.scholarshiptop.com>
RESEND_FROM=
# Optional: Reply-To on all Resend sends (where “Reply” in the mail client goes), e.g. support@scholarshiptop.com
# REPLY_TO_EMAIL=
# Provider outreach script only (`npm run provider-outreach:*`): overrides From / Reply-To for that job
# PROVIDER_OUTREACH_FROM=Daur <daur@mail.scholarshiptop.com>
# Reply-To for provider outreach (bulk and `--test` by default). Default support@scholarshiptop.com.
# PROVIDER_OUTREACH_REPLY_TO=support@scholarshiptop.com
# `--test` delivery address (where the sample email is sent)
# PROVIDER_OUTREACH_TEST_TO=loomany.self@gmail.com
# Optional: `--test` only — force a specific Reply-To (overrides default support)
# PROVIDER_OUTREACH_TEST_REPLY_TO=
# Optional: `--test` only — if 1, Reply-To = test inbox (you reply to yourself). Default 0: production-like Reply-To = support
# PROVIDER_OUTREACH_TEST_MIRROR_REPLY_TO_INBOX=
# Public base URL for links inside outreach emails (provider page, site link). Default https://scholarshiptop.com — do not point at ngrok; NEXT_PUBLIC_SITE_URL is ignored for this script.
# PROVIDER_OUTREACH_PUBLIC_SITE=https://scholarshiptop.com
# Optional: path to provider-partnerships-report.json — maps scraped emails → domain for personalized copy (default scripts/output/…)
# PROVIDER_OUTREACH_REPORT=
# Default outreach uses branded HTML in lib/email/templates/providerPartnershipOutreachEmailHtml.ts (see PROVIDER_OUTREACH_BODY_TEMPLATE there).
# Set both lines below only for a plain-text override (no dark template). Use \n for new lines in the value if your env supports it.
# Default branded mail: subject is built per recipient (Feature … at the top of ScholarshipTop). Optional fixed subject:
# PROVIDER_OUTREACH_SUBJECT=Feature [Organization Name] at the top of ScholarshipTop
# PROVIDER_OUTREACH_BODY=Hello,\n\nI'm Daur, founder of ScholarshipTop.com.\n\nWe list grant opportunities from organizations like yours, and [Organization Name] is already featured in our database.\n\nRight now, your page looks like a standard listing: [view your provider page link].\n\nI'm reaching out because I'd love to set up a dedicated Partner Dashboard for your team. This will allow you to easily enrich your profile, add your logo, and update your upcoming grant deadlines.\n\nAs soon as your profile is updated, we will boost your organization to the top of our official Providers Directory. This guarantees priority visibility among our most active applicants.\n\nTo support this, my team would also love to write a deep-dive article about your mission for our Resources section, handling all the writing and SEO to send relevant traffic back to your programs.\n\nAre you open to a brief exchange to get your dashboard access set up?\n\nBest regards,\n\nDaur Mussatay\nFounder, ScholarshipTop
# Optional: force one org name for every recipient (tests + bulk). Omit to use report map, else recipient domain; freemail → neutral copy
# PROVIDER_OUTREACH_ORG_NAME=Your Foundation Name
# Optional with fixed org: deep link /providers/[slug]
# PROVIDER_OUTREACH_PROVIDER_SLUG=your-provider-slug
# Optional HMAC secret for /auth/verify-email tokens (defaults to SUPABASE_SERVICE_ROLE_KEY if unset)
EMAIL_VERIFICATION_SECRET=

# SEO publish guard → Telegram admin (optional). When SEO_TELEGRAM_NOTIFY_ENABLED=1 and token + chat are set,
# warnings or score below 90 trigger one message per guard run. Never commit real tokens.
SEO_TELEGRAM_BOT_TOKEN=
SEO_TELEGRAM_ADMIN_CHAT_ID=
SEO_TELEGRAM_NOTIFY_ENABLED=0

# Telegram bot integration
TELEGRAM_BOT_TOKEN=
# First-touch visitor alerts (POST /api/analytics/first-touch). If unset, falls back to TELEGRAM_ADMIN_ID or first TELEGRAM_ADMIN_IDS.
TELEGRAM_CHAT_ID=
# Required in production: same value must be passed as secret_token when calling setWebhook (see docs/telegram-bot.md). If empty, webhook accepts any caller.
TELEGRAM_WEBHOOK_SECRET=
# Optional: comma- or newline-separated https URLs — adds "Скрин 1", "Скрин 2", ... link buttons to admin alert messages (traffic, auth, billing, etc.).
TELEGRAM_ADMIN_GALLERY_URLS=
# Optional override for hashing one-time email codes used by the Telegram bot
TELEGRAM_LINK_CODE_SECRET=
# Comma-separated Telegram user IDs that should see the admin panel and receive alerts
TELEGRAM_ADMIN_IDS=200082134
# Optional single admin ID (same as TELEGRAM_ADMIN_IDS entry; for docs/tools that expect one var)
TELEGRAM_ADMIN_ID=
# Where to post new /resources articles (channel or group ID, comma-separated). If unset, all admins with notifications get a DM.
TELEGRAM_RESOURCES_CHAT_ID=
# Bearer secret for POST /api/internal/resources/notify-published (falls back to CONTENT_ARTICLE_MATCH_SECRET)
TELEGRAM_RESOURCE_NOTIFY_SECRET=
# 0 = no Telegram notifications on new /resources articles (DB trigger still returns 200).
TELEGRAM_RESOURCE_PUBLISH_NOTIFY_ENABLED=0
# 1 = DM all users who used /start; omit or empty for TELEGRAM_RESOURCES_CHAT_ID / admins only.
# TELEGRAM_RESOURCES_BROADCAST_ALL=

# Optional drip-feed SEO: only first (elapsed_hour_slots * rate) paths from data/seo-pending-queue.json
# are indexable and in the scholarships SEO sitemap bucket. Set SEO_DRIP_ENABLED=false to disable drip
# while keeping dates for reference; omit SEO_DRIP_START_DATE or SEO_PAGES_PER_HOUR to disable.
# SEO_DRIP_ENABLED=false
# SEO_DRIP_START_DATE=2026-04-07T00:00:00.000Z
# SEO_PAGES_PER_HOUR=20

# GPTZero: POST /api/essay/check-ai (version must match API; see error text if 400)
GPTZERO_API_KEY=
GPTZERO_MODEL_VERSION=2026-03-30-base

# Undetectable.AI: POST /api/essay/undetectable-humanize
UNDETECTABLE_API_KEY=
# Запас на сервере для сниппетов/batch (без model в теле). Полный черновик — модель из UI. Можно оставить v2 или закомментировать (в коде всё равно v2).
# UNDETECTABLE_MODEL=v2