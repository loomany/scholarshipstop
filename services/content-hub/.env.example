OPENAI_API_KEY=
OPENAI_MODEL_STANDARD=gpt-4.1-mini
OPENAI_MODEL_SMART=gpt-4.1
OPENAI_MAX_COMPLETION_TOKENS=16384
# Optional when CONTENT_HUB_COVER_SOURCE=essay_reuse and CONTENT_HUB_FAL_FALLBACK=0.
FAL_KEY=
FAL_REQUEST_TIMEOUT_MS=180000
# FLUX.1 [dev] cover generation (fal-ai/flux/dev) — defaults match ScholarshipTop Essay Hub
FLUX_HERO_WIDTH=704
FLUX_HERO_HEIGHT=396
FLUX_HERO_INFERENCE_STEPS=28
# 0 = keep safety checker on
FLUX_HERO_DISABLE_SAFETY_CHECKER=0
FAL_HERO_MAX_ATTEMPTS=3
# Optional; 30000–300000 ms per attempt. If unset, FAL_REQUEST_TIMEOUT_MS is used (clamped).
# FAL_HERO_REQUEST_TIMEOUT_MS=120000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://yourdomain.com
METRICS_STRICTNESS=strict
PUBLICATION_INTERVAL_MINUTES=360
CONTINUOUS_MODE=false
RUN_REPROCESS_ON_START=false
PROCESS_EXTERNAL_LINKS=false
PROCESS_INTERNAL_LINKS=false
PROCESS_FORCE_UPDATE=false

CONTENT_HUB_AUTO_PUBLISH=0
CONTENT_HUB_REQUIRE_COVER_FOR_PUBLISH=1
CONTENT_HUB_POSTS_PER_RUN=1
CONTENT_HUB_MAX_TOPIC_ATTEMPTS=3
CONTENT_HUB_STALE_PROCESSING_HOURS=2

CONTENT_HUB_MIN_WORDS=1100
CONTENT_HUB_MIN_CHARS_NO_SPACES=6500
CONTENT_HUB_LENGTH_MULTIPLIER=0.5

# essay_reuse copies a suitable /essays hero into content-images first.
# Set CONTENT_HUB_FAL_FALLBACK=1 only if you want FAL used when no essay hero fits.
CONTENT_HUB_COVER_SOURCE=essay_reuse
CONTENT_HUB_FAL_FALLBACK=0

CONTENT_HUB_ENABLE_SCHOLARSHIP_LINKING=1
CONTENT_HUB_ENABLE_FAQ_LINKS=1
CONTENT_HUB_ENABLE_RELATED_ARTICLES=1
CONTENT_HUB_ENABLE_EXTERNAL_LINKS=1

CONTENT_HUB_MAX_SCHOLARSHIP_LINKS=4
CONTENT_HUB_MAX_FAQ_LINKS=3
CONTENT_HUB_MAX_RELATED_ARTICLES=4

CONTENT_HUB_MIN_RELATED_ARTICLES=2

IMAGE_WATERMARK_ENABLED=1
IMAGE_WATERMARK_TEXT=ScholarshipTop.com

# Internal site endpoint trigger for article scholarship matching after publish
CONTENT_ARTICLE_MATCH_PATH=/api/internal/resources/apply-article-matching
CONTENT_ARTICLE_MATCH_SECRET=
