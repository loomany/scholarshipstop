# VPS PostgreSQL — NO SECRETS
# Copy to /opt/scholarshiptop/env/postgres.env and chmod 600
# Used by backup scripts, restore-test, and future DATABASE_URL consumers.

# Direct Postgres connection (app user, not superuser)
# Format: postgresql://USER:PASSWORD@127.0.0.1:5432/scholarshiptop_prod
DATABASE_URL=REQUIRED_SET_ON_VPS

# Switch flag for staged migration (site code — Stage 4+)
# supabase = current production default
# vps_postgres = after cutover validation
DB_PROVIDER=supabase

# Database name and role (for setup/backup scripts)
POSTGRES_DB=scholarshiptop_prod
POSTGRES_USER=scholarshiptop_app
# POSTGRES_PASSWORD=REQUIRED_SET_ON_VPS

# Backup directory on VPS host
POSTGRES_BACKUP_DIR=/opt/scholarshiptop-db-backups

# Retention (days) for daily pg_dump files
POSTGRES_BACKUP_RETENTION_DAYS=14

# Supabase direct DB URL — export ONLY, never commit
# Used by scripts/vps-migration/export-supabase-prod-dump.sh
# SUPABASE_DB_URL=REQUIRED_FOR_EXPORT_ONLY
