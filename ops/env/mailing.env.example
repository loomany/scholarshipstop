# ScholarshipTop VPS env template — NO SECRETS
# Service: Рассылка (slug: mailing)
# Copy to /opt/scholarshiptop/env/mailing.env and chmod 600
# Values: set manually from Railway dashboard or secret manager

GRANT_DIGEST_EMAIL_MAX_ITEMS=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_CRON_SECRET=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_EMAIL_COOLDOWN_HOURS=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_LOOKBACK_HOURS=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_MAX_OPS=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_MAX_PROFILES=REQUIRED_SET_ON_VPS
GRANT_NOTIFICATION_MAX_SCHOLARSHIPS=REQUIRED_SET_ON_VPS
NEXT_PUBLIC_SITE_URL=REQUIRED_SET_ON_VPS
NEXT_PUBLIC_SUPABASE_URL=REQUIRED_SET_ON_VPS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REQUIRED_SET_ON_VPS
