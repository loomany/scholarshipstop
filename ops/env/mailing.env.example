MAIL_FROM=ScholarshipTop <hello@mail.scholarshiptop.com>
GRANT_DIGEST_TOKEN_SECRET=REQUIRED_SET_ON_VPS
SUPABASE_SERVICE_ROLE_KEY=REQUIRED_SET_ON_VPS
