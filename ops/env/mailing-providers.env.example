# ScholarshipTop VPS env template — NO SECRETS
# Service: Рассылка провайдеры (slug: mailing-providers)
# Copy to /opt/scholarshiptop/env/mailing-providers.env and chmod 600
# Values: set manually from Railway dashboard or secret manager

NEXT_PUBLIC_SUPABASE_URL=REQUIRED_SET_ON_VPS
PROVIDER_OUTREACH_MS_BETWEEN=OPTIONAL_SET_ON_VPS
PROVIDER_OUTREACH_PUBLIC_SITE=REQUIRED_SET_ON_VPS
PROVIDER_OUTREACH_TELEGRAM_NOTIFY=OPTIONAL_SET_ON_VPS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REQUIRED_SET_ON_VPS
SMTP_PASS=REQUIRED_SET_ON_VPS
MAIL_FROM=ScholarshipTop <hello@mail.scholarshiptop.com>
SUPABASE_SERVICE_ROLE_KEY=REQUIRED_SET_ON_VPS
TELEGRAM_ADMIN_IDS=REQUIRED_SET_ON_VPS
TELEGRAM_BOT_TOKEN=REQUIRED_SET_ON_VPS
