GOOGLE_INDEXING_IMMEDIATE_SHARE_PERCENT=OPTIONAL_SET_ON_VPS
GOOGLE_INDEXING_MAX_PUBLISH_PER_DAY=OPTIONAL_SET_ON_VPS
GOOGLE_INDEXING_PRIVATE_KEY=REQUIRED_SET_ON_VPS
GOOGLE_INDEXING_SCHOLARSHIP_SHARE_PERCENT=OPTIONAL_SET_ON_VPS
GOOGLE_INDEXING_SECRET=REQUIRED_SET_ON_VPS
GOOGLE_SEARCH_CONSOLE_SITE_URL=REQUIRED_SET_ON_VPS
NEXT_PUBLIC_SITE_URL=REQUIRED_SET_ON_VPS
NEXT_PUBLIC_SUPABASE_URL=REQUIRED_SET_ON_VPS
PUBLIC_URL=REQUIRED_SET_ON_VPS
SITE_URL=REQUIRED_SET_ON_VPS
SUPABASE_SERVICE_ROLE_KEY=REQUIRED_SET_ON_VPS
TELEGRAM_ADMIN_IDS=REQUIRED_SET_ON_VPS
TELEGRAM_BOT_TOKEN=REQUIRED_SET_ON_VPS
URL_INSPECTION_MAX_PER_RUN=OPTIONAL_SET_ON_VPS
