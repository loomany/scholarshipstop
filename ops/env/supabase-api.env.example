# VPS self-hosted Supabase API layer — NO SECRETS
# Copy to /opt/scholarshiptop/env/supabase-api.env and chmod 600
# Used ONLY by docker-compose.supabase-api.example.yml (Stage 4B+ test stack)
# Production site.env MUST NOT be changed until explicit cutover approval.

# --- Shared Postgres (VPS localhost, restored Supabase schema) ---
# Format: postgresql://USER:PASSWORD@host.docker.internal:5432/scholarshiptop_prod
GOTRUE_DB_DATABASE_URL=REQUIRED_SET_ON_VPS
POSTGREST_DB_URI=REQUIRED_SET_ON_VPS

# Must match Supabase project JWT secret for existing anon/service JWT keys to validate.
# Copy from Supabase Dashboard → Project Settings → API → JWT Secret (never commit).
JWT_SECRET=REQUIRED_COPY_FROM_SUPABASE_DASHBOARD

# --- GoTrue (Auth) ---
GOTRUE_SITE_URL=https://scholarshiptop.com
GOTRUE_URI_ALLOW_LIST=https://scholarshiptop.com,https://www.scholarshiptop.com,http://127.0.0.1:54321,http://127.0.0.1:3100,http://127.0.0.1:3101
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
# SMTP optional if all transactional email goes through Resend + admin.generateLink
GOTRUE_SMTP_HOST=REQUIRED_OR_LEAVE_EMPTY_IF_RESEND_ONLY
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=REQUIRED_SET_ON_VPS
GOTRUE_SMTP_PASS=REQUIRED_SET_ON_VPS
GOTRUE_SMTP_ADMIN_EMAIL=noreply@scholarshiptop.com
GOTRUE_SMTP_SENDER_NAME=ScholarshipTop

# Google OAuth (same client as Supabase Auth provider; add redirect URI for test host)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=REQUIRED_SET_ON_VPS
GOTRUE_EXTERNAL_GOOGLE_SECRET=REQUIRED_SET_ON_VPS
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://scholarshiptop.com/supabase/auth/v1/callback

# --- PostgREST (REST / RLS) ---
POSTGREST_DB_SCHEMAS=public,storage,graphql_public
POSTGREST_DB_ANON_ROLE=anon
POSTGREST_DB_EXTRA_SEARCH_PATH=public,extensions
POSTGREST_JWT_SECRET=REQUIRED_SAME_AS_JWT_SECRET_ABOVE

# --- Anon / service role keys (for smoke tests only; same values as production site.env) ---
# These are JWTs signed with JWT_SECRET — do not commit real values.
SUPABASE_ANON_KEY=REQUIRED_SAME_AS_NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REQUIRED_SAME_AS_PRODUCTION_SERVICE_ROLE

# --- Site mapping (Stage 4B smoke — test stack only) ---
# When running isolated smoke, point test client at internal URL:
# SELFHOST_API_BASE_URL=http://127.0.0.1:54321
SELFHOST_API_BASE_URL=http://127.0.0.1:54321
DB_PROVIDER=supabase
