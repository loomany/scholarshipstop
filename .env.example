TELEGRAM_RESOURCE_PUBLISH_NOTIFY_ENABLED="0"
# 1 = DM all bot users who used /start. Empty = only TELEGRAM_RESOURCES_CHAT_ID or admin fallback.
TELEGRAM_RESOURCES_BROADCAST_ALL=""
# Real chat model id (see OpenAI docs). Avoid typos like gpt-gpt-4o-mini.
OPENAI_ESSAY_MODEL=gpt-5.4
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VOICE_CLEANUP_MODEL=gpt-4o-mini
GPTZERO_API_KEY=REQUIRED_SET_ON_VPS
GPTZERO_MODEL_VERSION=2026-03-30-base
UNDETECTABLE_MODEL=v2
UNDETECTABLE_API_KEY=REQUIRED_SET_ON_VPS
FAL_KEY="REQUIRED_SET_ON_VPS"
# Optional: POST /api/voice-to-text (Whisper + cleanup). Defaults: whisper-1, gpt-4o-mini.
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_VOICE_CLEANUP_MODEL=gpt-4o-mini

# GPTZero: POST /api/essay/check-ai. Key: https://gptzero.me/developers
# Version must be one of API-allowed model ids (error message lists options if invalid).
GPTZERO_API_KEY=
GPTZERO_MODEL_VERSION=2026-03-30-base

# POST /api/essay/humanize (Magic Humanize). Default model: gpt-4o, then OPENAI_ESSAY_MODEL.
# OPENAI_HUMANIZE_MODEL=gpt-4o

# Undetectable.AI Humanization API v2: POST /api/essay/undetectable-humanize (popover «Очеловечить» в редакторе).
# Key: https://undetectable.ai/dashboard — header apikey (not Bearer). Min 50 chars per request.
UNDETECTABLE_API_KEY=
# RU: UNDETECTABLE_MODEL не убирайте ради «динамики» в UI. Это серверный запасной вариант, когда клиент НЕ шлёт
# model (сниппеты в попапе, batch по подсветкам). «Humanize entire draft» передаёт модель сама — env для неё не конфликтует.
# EN: Keep as fallback when request has no model. Full-draft humanize sends model from the dropdown.
# Optional: v2 (multilingual default), v11 / v11sr (English-focused)
# UNDETECTABLE_MODEL=v2
# Quality | Balanced | More Human — по умолчанию в коде: More Human. Для ближе к исходнику: Quality или Balanced.
# UNDETECTABLE_STRENGTH=More Human
# Макс. длина ответа относительно входа (1.2 = +20%). 0 = не обрезать, если API вернул длинный текст.
# UNDETECTABLE_MAX_OUTPUT_LENGTH_RATIO=1.2
# Optional: AI Detector API (POST /api/essay/check-ai with detector=undetectable) — same UNDETECTABLE_API_KEY; see https://help.undetectable.ai/en/article/detector-api-1cf74il
# Undetectable returns only an overall score; snippet highlights in the essay editor use GPTZero on the same text (set GPTZERO_API_KEY).
# UNDETECTABLE_DETECT_MODEL=xlm_ud_detector

# Optional: /essays index hero — YouTube video id (e.g. dQw4w9WgXcQ) instead of local file `public/videos/IMG_1482.MP4`
# NEXT_PUBLIC_ESSAYS_HERO_YOUTUBE_ID=

# --- Essay Hub (/essays) programmatic guides + cron ---
# Required for publishing: FAL generates a temp image; the worker downloads it, re-encodes WebP (sharp), uploads to Supabase Storage bucket `essay-heroes`, then saves the public URL on `essays.hero_image_url`.
# Apply migration `supabase/migrations/*_essay_heroes_storage_bucket.sql` on your Supabase project (db push / SQL editor).
# FAL_KEY=your_fal_api_key
# Essay Hub hero is always FLUX.1 [dev] (fal-ai/flux/dev, 16:9) — no alternate backend.
# FLUX is billed per megapixel — lower FLUX_HERO_WIDTH × FLUX_HERO_HEIGHT = lower cost (defaults 704×396 ≈0.28 MP vs 768×432 ≈0.33 MP).
# Budget: 640×360 (~0.23 MP). Quality: 768×432 or 896×504.
# FLUX_HERO_WIDTH=704
# FLUX_HERO_HEIGHT=396
# Optional: FLUX inference steps (12–50). Default 28.
# FLUX_HERO_INFERENCE_STEPS=28
# Retries when FAL returns 429/5xx, timeouts, or JSON without an image URL (default 3; set 1 for single attempt).
# FAL_HERO_MAX_ATTEMPTS=3
# POST https://fal.run/... timeout in ms (default 120000).
# FAL_HERO_REQUEST_TIMEOUT_MS=120000
# If FLUX keeps returning empty images (over-eager safety), set to 1 to disable checker (use sparingly).
# FLUX_HERO_DISABLE_SAFETY_CHECKER=
# Optional: override OpenAI model for guide HTML JSON
# ESSAY_HUB_OPENAI_MODEL=gpt-4o-mini
#
# Homepage “Success Stories” avatars (optional): same FAL_KEY — `npx dotenv-cli -e .env.local -- npx tsx scripts/generate-success-stories-avatars.ts` → `public/images/success-stories/avatar-*.webp`
#
# Homepage “Featured Brands” (optional): Fal Nano Banana 2 → WebP per unique `brandDomain` in `public/images/featured-brands/domains/`
# npm run featured-brands:generate-home-logos
# npm run featured-brands:generate-strip-only   — optional 16:9 strip (amd/google/ms)
# npm run featured-brands:generate-skip-existing — only missing domain files
#
# --- Content Hub resource articles (`content_posts.cover_image_url`) ---
# Covers are always generated with FLUX.1 [dev] (`fal-ai/flux/dev`) in code — see `lib/content-hub/resourceCoverFromFlux.ts`.
# Essay Hub uses FLUX only; resource covers also use FLUX (separate code path).
#
# Cron auth: Bearer token for GET/POST /api/cron/process-essay-queue (falls back to CRON_SECRET)
# ESSAY_CRON_SECRET=
# Pause Essay Hub worker (cron + local scripts): skips jobs without DB changes. Values: 1, true, yes
# ESSAY_GENERATION_DISABLED=
# Reuse existing published essay hero images only (no FAL calls). Values: 1, true, yes
# ESSAY_HUB_HERO_REUSE_ONLY=
# Telegram alert cooldown (minutes) when reuse pool cannot keep first 3 /essays pages unique.
# ESSAY_HUB_HERO_SHORTAGE_ALERT_COOLDOWN_MINUTES=180
# After a failed queue job, wait this many minutes before auto re-queue (failed→pending). Set 0 for immediate retry (e.g. local testing). Default: 15
# ESSAY_QUEUE_FAILED_RETRY_AFTER_MINUTES=15
# Reset zombie `processing` rows older than N minutes back to `pending` (default 90). Set 0 to disable.
# ESSAY_QUEUE_STALE_PROCESSING_RESET_MINUTES=90
# Compare essays vs hero URL hosts + queue: npm run essay:audit-fal
