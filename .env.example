# /resources/[slug] only — internal autolinking for content_posts.body_html (off unless set to 1).
# CONTENT_HUB_ENABLE_AUTO_INTERNAL_LINKS="1"
# Optional cap when enabled (defaults to 3 if unset).
# CONTENT_HUB_AUTO_LINK_MAX_PER_ARTICLE="3"
RESEND_API_KEY="REQUIRED_SET_ON_VPS"
RESEND_FROM="REQUIRED_SET_ON_VPS"
# Duplicate Lemon’s purchase receipt with our Resend “subscription active” email (default: off — SaaS-friendly).
# SUBSCRIPTION_RESEND_WELCOME_ON_PURCHASE=1
PROVIDERS_REVALIDATE_SECRET="REQUIRED_SET_ON_VPS"
# Set to false to disable staged SEO rollout; queue is ignored. Omit or true to use drip when SEO_DRIP_START_DATE + SEO_PAGES_PER_HOUR are set.
SEO_DRIP_ENABLED="false"
SEO_DRIP_START_DATE="2026-04-08T00:00:00Z"
# How many paths from data/seo-pending-queue.json unlock per hour after start (drip). Does not change on-page quality—only release speed. Lower (e.g. 8–12) if Google Search Console shows crawl budget strain; raise cautiously (e.g. 24–40) once listings are solid.
SEO_PAGES_PER_HOUR="20"
GOOGLE_INDEXING_CLIENT_EMAIL="REQUIRED_SET_ON_VPS"
# Optional: must match the Search Console property URL (default: NEXT_PUBLIC_SITE_URL with trailing slash).
# GOOGLE_SEARCH_CONSOLE_SITE_URL="https://scholarshiptop.com/"
GOOGLE_INDEXING_SECRET="REQUIRED_SET_ON_VPS"
# Cap Indexing API publish calls per Pacific day (default 200 — matches GCP quota). See https://developers.google.com/search/apis/indexing-api/v3/quota
# GOOGLE_INDEXING_MAX_PUBLISH_PER_DAY="200"
# Split of daily cap between direct event sends and queue flush.
# GOOGLE_INDEXING_IMMEDIATE_SHARE_PERCENT="50"
# Share inside each lane reserved for scholarship URLs; remaining quota is split equally across resource/provider/essay/page.
# GOOGLE_INDEXING_SCHOLARSHIP_SHARE_PERCENT="80"
# URL Inspection (Search Console) per POST — cap each of check-index-worker + scan-indexing (max 100 hard limit in code). ~2000/day Google quota.
# URL_INSPECTION_MAX_PER_RUN="45"
GOOGLE_INDEXING_PRIVATE_KEY=REQUIRED_SET_ON_VPS
