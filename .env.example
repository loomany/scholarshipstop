GRANT_NOTIFICATION_EMAIL_COOLDOWN_HOURS="24"
# One-off repair resend: ignores email cooldown, email duplicate delivery, and recent digest item history.
# Use only manually, e.g. GRANT_NOTIFICATION_EMAIL_RESEND_ALL=1 npx tsx scripts/cron-grant-notifications.ts
# GRANT_NOTIFICATION_EMAIL_RESEND_ALL="0"
# Daily grant digest layout and fallback rotation.
# GRANT_DIGEST_BEST_MAX_ITEMS="2"
# GRANT_DIGEST_MIN_TOTAL_ITEMS="3"
# GRANT_DIGEST_FALLBACK_LOOKBACK_DAYS="30"
# GRANT_DIGEST_FALLBACK_MAX_ITEMS="2"
# GRANT_DIGEST_FALLBACK_POOL_SIZE="120"
# GRANT_DIGEST_FALLBACK_MIN_MATCH_PERCENT="55"
